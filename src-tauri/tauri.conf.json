{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LalaLM",
  "version": "0.2.1",
  "identifier": "com.lalalm.app",
  "build": {
    "beforeDevCommand": "node scripts/ensure-sidecars.mjs && pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/ensure-sidecars.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LalaLM — Local LLM Manager",
        "width": 1340,
        "height": 870,
        "minWidth": 1020,
        "minHeight": 660,
        "center": true,
        "backgroundColor": "#0e1016",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "icon": ["icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "externalBin": ["binaries/aria2c"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
